# Docker host address for published UIs.
# Keep 127.0.0.1 and use SSH/Tailscale port forwarding for the safest default.
UI_BIND_ADDRESS=0.0.0.0

# Host-side UI ports.
SPARK_MASTER_UI_HOST_PORT=19080
SPARK_WORKER1_UI_HOST_PORT=19081
SPARK_WORKER2_UI_HOST_PORT=19082
SPARK_HISTORY_UI_HOST_PORT=18080
SPARK_APP_UI_HOST_PORT=14040

# Local lab resources. Tune to your server; start small.
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# Image is pinned so benchmark runs stay reproducible.
SPARK_IMAGE=apache/spark:4.2.0-python3
